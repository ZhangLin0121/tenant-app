# 本地开发默认（推荐本机验证时使用）
MONGO_URI=mongodb://127.0.0.1:27017/tenantDB

# 云端示例（如使用 Atlas），需要时可改为下方并填写账号
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<db>?retryWrites=true&w=majority
PLATFORM_USERNAME=<your_platform_username>
PLATFORM_PASSWORD=<your_platform_password>
PORT=5001
PLATFORM_ENTERPRISE_IDS=227
PLATFORM_CONTRACT_ID=1489

# Copy to .env and fill real values. Do NOT commit .env.
